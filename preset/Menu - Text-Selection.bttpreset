                "BTTAppleScriptRunInBackground" : true,
                "BTTScriptString" : "var BT=String.fromCharCode(96),BT3=BT+BT+BT;\nfunction de(s){return s.replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'\"').replace(/&#39;/g,\"'\").replace(/&nbsp;/g,' ').replace(/&#(\\d+);/g,function(_,n){return String.fromCharCode(+n)}).replace(/&#x([0-9a-f]+);/gi,function(_,n){return String.fromCharCode(parseInt(n,16))})}\nfunction il(s){s=s.replace(/<code[^>]*>([\\s\\S]*?)<\\/code>/gi,function(_,c){return BT+de(c)+BT});s=s.replace(/<(?:strong|b)\\b[^>]*>([\\s\\S]*?)<\\/(?:strong|b)>/gi,function(_,c){return '**'+c.replace(/<[^>]+>/g,'')+'**'});s=s.replace(/<(?:em|i)\\b[^>]*>([\\s\\S]*?)<\\/(?:em|i)>/gi,function(_,c){return '*'+c.replace(/<[^>]+>/g,'')+'*'});s=s.replace(/<(?:del|s)\\b[^>]*>([\\s\\S]*?)<\\/(?:del|s)>/gi,function(_,c){return '~~'+c.replace(/<[^>]+>/g,'')+'~~'});s=s.replace(/<a\\s[^>]*href=\"([^\"]*)\"[^>]*>([\\s\\S]*?)<\\/a>/gi,function(_,h,t){return '['+t.replace(/<[^>]+>/g,'')+']('+h+')'});s=s.replace(/<img[^>]*\\bsrc=\"([^\"]*)\"[^>]*\\/?>/gi,function(_,src){var alt=(_.match(/alt=\"([^\"]*)\"/)||[])[1]||'';return '!['+alt+']('+src+')'});return s}\nfunction toMd(h){var cbs=[];h=h.replace(/<pre[^>]*>\\s*<code[^>]*?(?:class=\"[^\"]*?language-(\\w+)[^\"]*?\")?[^>]*?>([\\s\\S]*?)<\\/code>\\s*<\\/pre>/gi,function(_,lang,code){cbs.push(BT3+(lang||'')+'\\n'+de(code).trim()+'\\n'+BT3);return '\\n\\x00B'+(cbs.length-1)+'\\x00\\n'});h=h.replace(/<pre[^>]*>([\\s\\S]*?)<\\/pre>/gi,function(_,code){cbs.push(BT3+'\\n'+de(code).trim()+'\\n'+BT3);return '\\n\\x00B'+(cbs.length-1)+'\\x00\\n'});h=h.replace(/<h([1-6])[^>]*>([\\s\\S]*?)<\\/h\\1>/gi,function(_,n,c){return '\\n'+'#'.repeat(+n)+' '+il(c).trim()+'\\n'});h=h.replace(/<blockquote[^>]*>([\\s\\S]*?)<\\/blockquote>/gi,function(_,c){return '\\n'+toMd(c).split('\\n').map(function(l){return '> '+l}).join('\\n')+'\\n'});h=h.replace(/<hr[^>]*\\/?>/gi,'\\n---\\n');h=h.replace(/<ol[^>]*>([\\s\\S]*?)<\\/ol>/gi,function(_,c){var i=0;return '\\n'+c.replace(/<li[^>]*>([\\s\\S]*?)<\\/li>/gi,function(_,t){return(++i)+'. '+il(t).trim()+'\\n'}).replace(/<[^>]+>/g,'')});h=h.replace(/<ul[^>]*>([\\s\\S]*?)<\\/ul>/gi,function(_,c){return '\\n'+c.replace(/<li[^>]*>([\\s\\S]*?)<\\/li>/gi,function(_,t){return '- '+il(t).trim()+'\\n'}).replace(/<[^>]+>/g,'')});h=h.replace(/<p[^>]*>([\\s\\S]*?)<\\/p>/gi,function(_,c){return '\\n'+il(c).trim()+'\\n'});h=h.replace(/<br[^>]*\\/?>/gi,'\\n');h=il(h);h=h.replace(/<[^>]+>/g,'');for(var i=0;i<cbs.length;i++){h=h.replace('\\x00B'+i+'\\x00',cbs[i])}h=de(h);return h.replace(/\\n{3,}/g,'\\n\\n').trim()}\nasync function main(){var html=await get_selection({format:'public.html'});if(!html||!html.trim()){returnToBTT('No selection');return}var m=html.match(/<body[^>]*>([\\s\\S]*)<\\/body>/i);if(m)html=m[1];var md=toMd(html);await set_clipboard_content({content:md,format:'NSPasteboardTypeString'});returnToBTT('Done')}\nmain();"
