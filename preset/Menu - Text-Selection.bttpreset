                  "BTTUUID" : "4C0363B4-EAB4-4F09-B392-C176BF9DF029",
                  "BTTPredefinedActionType" : 490,
                  "BTTPredefinedActionName" : "Comment (Does Nothing Else)",
                  "BTTGenericActionConfig" : "This only shows if the selected text contains a URL and if so can open that URL",
