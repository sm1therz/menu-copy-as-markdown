                  "BTTMenuItemActions" : [
                    {
                      "BTTLastUpdatedAt" : 1788028361.105835,
                      "BTTTriggerParentUUID" : "8F27DA79-3212-49DB-A62E-66FEBC208504",
                      "BTTTriggerClass" : "BTTTriggerTypeFloatingMenu",
                      "BTTUUID" : "E9078301-99BF-4356-AE22-1D17EEACA1E1",
                      "BTTPredefinedActionType" : 284,
                      "BTTPredefinedActionName" : "Transform & Replace Selection With Java Script",
                      "BTTAdditionalActionData" : {
                        "SelectedTransformerTab" : 1,
                        "BTTClipboardTransformerJS" : "async (clipboardContentString) => {\n   function isLikelyUrl(str) {\n  // A very basic regex for demonstration. \n  // For more robust checks, consider more elaborate patterns.\n  const urlPattern = /^https?:\\/\\/[^\\s/$.?#].[^\\s]*$/i;\n  return urlPattern.test(str);\n}\n\nfunction createMarkdownLink(input, fallbackText = \"click_here\", fallbackUrl = \"the_url_here\") {\n  const trimmed = input.trim();\n  if (isLikelyUrl(trimmed)) {\n    // If it looks like a URL, use it as the link target, with fallback text.\n    return `[${fallbackText}](${trimmed})`;\n  } else {\n    // Otherwise, use it as the link text, with a fallback URL.\n    return `[${trimmed}](${fallbackUrl})`;\n  }\n}\n   return createMarkdownLink(clipboardContentString);\n}"
                      },
                      "BTTOrder" : 54,
                      "BTTMenuConfig" : {
                        "BTTMenuElementIdentifier" : "9487AF64-D017-440A-9D87-0CA6B467CCDF",
