        {
          "BTTLastUpdatedAt" : 1788027153.8553441,
          "BTTTriggerType" : 679,
          "BTTTriggerTypeDescriptionReadOnly" : "Clipboard Manager / Java Script Transformer: To Greek",
          "BTTTriggerClass" : "BTTTriggerTypeOtherTriggers",
          "BTTUUID" : "3FD267A7-FB42-4AFC-BE2A-CEC1E3B02661",
          "BTTAdditionalConfiguration" : "To Greek",
          "BTTOrder" : 3,
          "BTTActionsToExecute" : [
            {
              "BTTLastUpdatedAt" : 1788027153.856108,
              "BTTTriggerParentUUID" : "3FD267A7-FB42-4AFC-BE2A-CEC1E3B02661",
              "BTTIsPureAction" : true,
              "BTTUUID" : "6544ADF2-CAEC-41AE-82FB-D43BE825686F",
              "BTTPredefinedActionType" : 490,
              "BTTPredefinedActionName" : "Comment (Does Nothing Else)",
              "BTTGenericActionConfig" : "This is just a example for a Java Script transformer that changes latin characters to greek characters.",
              "BTTOrder" : 53
            }
          ],
          "BTTClipboardTransformerInfo" : {
            "BTTClipboardTransformerExampleInput" : "test",
            "BTTClipboardTransformerJS" : "async (clipboardContentString) => {\n    const alphabetEN = \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\";\n    const alphabetGR = \"αβψδεφγηιξκλμνοπ;ρστθωςχυζΑΒΨΔΕΦΓΗΙΞΚΛΜΝΟΠ;ΡΣΤΘΩΧΥΖ\";\n\n    // Determine if the first character is in the English alphabet\n    const firstIsEnglish = alphabetEN.indexOf(clipboardContentString[0]) !== -1 || alphabetGR.indexOf(clipboardContentString[0]) === -1;\n\n    let newMessage = \"\";\n\n    if (firstIsEnglish) {\n        // Convert only English letters to Greek\n        for (const char of clipboardContentString) {\n            const idx = alphabetEN.indexOf(char);\n            if (idx !== -1) {\n                // If char is English, map it to the Greek equivalent\n                newMessage += alphabetGR[idx];\n            } else {\n                // Keep anything else (already Greek or punctuation) as is\n                newMessage += char;\n            }\n        }\n    } else {\n      \n        // Convert only Greek letters to English\n        for (const char of clipboardContentString) {\n            const idx = alphabetGR.indexOf(char);\n            if (idx !== -1) {\n                // If char is Greek, map it to the English equivalent\n                newMessage += alphabetEN[idx];\n            } else {\n                // Keep anything else (already English or punctuation) as is\n                newMessage += char;\n            }\n        }\n    }\n\n    return newMessage;\n};"
          },
          "BTTClipboardTransformerName" : "To Greek"
        },
