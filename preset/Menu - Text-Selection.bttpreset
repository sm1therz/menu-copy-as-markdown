          "BTTAutoAdaptToKeyboardLayout" : 0,
          "BTTActionsToExecute" : [
            {
              "BTTLastUpdatedAt" : 1788027153.8529801,
              "BTTTriggerParentUUID" : "BF41580D-B31C-441B-9C95-ABC8DE97F0B2",
              "BTTIsPureAction" : true,
              "BTTUUID" : "066C91A2-99C2-42F8-970C-65DEEFB3EA49",
              "BTTPredefinedActionType" : 490,
              "BTTPredefinedActionName" : "Comment (Does Nothing Else)",
              "BTTGenericActionConfig" : "Sometimes it can be useful to show the text selection menu even if no text is selected. This trigger will move the current clipboard content to the BTTTextSelection variable, so the menu will run on the current clipboard content instead of the selected text.",
              "BTTOrder" : 0
            },
            {
              "BTTLastUpdatedAt" : 1788027153.853755,
              "BTTTriggerParentUUID" : "BF41580D-B31C-441B-9C95-ABC8DE97F0B2",
              "BTTIsPureAction" : true,
              "BTTUUID" : "5A51C1DB-EE1D-4C44-A2DC-B0DEEE1BEE03",
              "BTTPredefinedActionType" : 281,
              "BTTPredefinedActionName" : "Run Real JavaScript",
              "BTTAdditionalActionData" : {
                "BTTScriptFunctionToCall" : "moveClipboardToSelection",
                "BTTJavaScriptUseIsolatedContext" : false,
                "BTTAppleScriptRunInBackground" : false,
                "BTTScriptType" : 3,
                "BTTActionJSRunInSeparateContext" : false,
                "BTTScriptString" : "async function moveClipboardToSelection() {\n   let clipboardContents = await get_clipboard_content({});\n   \n  await set_string_variable({variableName: \"BTTTextSelection\", to: clipboardContents});\n\t\treturn clipboardContents;\n}\n",
                "BTTAppleScriptUsePath" : false,
                "BTTScriptLocation" : 0
              },
              "BTTGenericActionConfig" : "async function moveClipboardToSelection() {\n   let clipboardContents = await get_clipboard_content({});\n   \n  await set_string_variable({variableName: \"BTTTextSelection\", to: clipboardContents});\n\t\treturn clipboardContents;\n}\n",
              "BTTOrder" : 1
            },
            {
              "BTTLastUpdatedAt" : 1788027153.854521,
              "BTTTriggerParentUUID" : "BF41580D-B31C-441B-9C95-ABC8DE97F0B2",
              "BTTIsPureAction" : true,
