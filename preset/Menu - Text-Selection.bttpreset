              "BTTMenuItemActions" : [
                {
                  "BTTLastUpdatedAt" : 1788028361.0966039,
                  "BTTTriggerParentUUID" : "ACF80CB3-8C54-4089-8B7C-43C774376F6C",
                  "BTTIsPureAction" : true,
                  "BTTUUID" : "80138B2B-5F6D-4781-AF86-E1014BFC946F",
                  "BTTPredefinedActionType" : 490,
                  "BTTPredefinedActionName" : "Comment (Does Nothing Else)",
                  "BTTGenericActionConfig" : "This shortens the selected url and copies it to your clipboard",
                  "BTTOrder" : 0
                },
                {
                  "BTTLastUpdatedAt" : 1788028361.0971069,
                  "BTTTriggerParentUUID" : "ACF80CB3-8C54-4089-8B7C-43C774376F6C",
                  "BTTTriggerClass" : "BTTTriggerTypeFloatingMenu",
                  "BTTUUID" : "C7A9B798-B9D1-4B48-8689-195F94BDF6F6",
                  "BTTPredefinedActionType" : 281,
                  "BTTPredefinedActionName" : "Run Real JavaScript",
                  "BTTAdditionalActionData" : {
                    "BTTScriptFunctionToCall" : "shortenLink",
                    "BTTJavaScriptUseIsolatedContext" : false,
                    "BTTAppleScriptRunInBackground" : false,
                    "BTTScriptType" : 3,
                    "BTTActionJSRunInSeparateContext" : false,
                    "BTTScriptString" : "function extractFirstLink(text) {\n  // Regular Expression Breakdown:\n  //\n  // 1. Scheme-based URLs:\n  //    - [a-zA-Z][a-zA-Z0-9+\\-.]*://\n  //      - Scheme starts with a letter, followed by letters, numbers, +, -, or .\n  //    - [^\\s\"'`<>]+\n  //      - URL body excludes whitespace, quotes, backticks, and angle brackets\n  //\n  // Note: Removed the Bare Domains pattern to ensure only scheme-based URLs are matched.\n  const urlRegex = /[a-zA-Z][a-zA-Z0-9+\\-.]*:\\/\\/[^\\s\"'`<>]+/;\n\n  const match = text.match(urlRegex);\n  if (!match) {\n    return null;\n  }\n\n  // Since we're only matching URLs with a scheme, no need to prepend 'https://'\n  return match[0];\n}\n\n\nasync function shortenLink() {\n\nlet selectedText = await get_string_variable(\"BTTTextSelection\");\n\t\n\tlet link = extractFirstLink(selectedText);\n\t\n\tif(!link) {\n selectedText = await get_string_variable(\"BTTTextSelectionRTF\");\n\t\n\tlink = extractFirstLink(selectedText);\n   }\n   if(link) {\n   let b64 = await fetchURLAsBase64(`https://is.gd/create.php?format=simple&url=${link}`);\n   let shortened = atob(b64);\n   \n    await set_clipboard_content({content:shortened, format: 'NSPasteboardTypeURL'})\n   set_string_variable({variableName: \"ShortenedURL\", to: shortened});\n   return shortened;\n\n   }\n   \n   // https://heise.de\n\n\n\t\treturn \"no link found\";\n}",
                    "BTTAppleScriptUsePath" : false,
                    "BTTScriptLocation" : 0
                  },
                  "BTTGenericActionConfig" : "function extractFirstLink(text) {\n  // Regular Expression Breakdown:\n  //\n  // 1. Scheme-based URLs:\n  //    - [a-zA-Z][a-zA-Z0-9+\\-.]*://\n  //      - Scheme starts with a letter, followed by letters, numbers, +, -, or .\n  //    - [^\\s\"'`<>]+\n  //      - URL body excludes whitespace, quotes, backticks, and angle brackets\n  //\n  // Note: Removed the Bare Domains pattern to ensure only scheme-based URLs are matched.\n  const urlRegex = /[a-zA-Z][a-zA-Z0-9+\\-.]*:\\/\\/[^\\s\"'`<>]+/;\n\n  const match = text.match(urlRegex);\n  if (!match) {\n    return null;\n  }\n\n  // Since we're only matching URLs with a scheme, no need to prepend 'https://'\n  return match[0];\n}\n\n\nasync function shortenLink() {\n\nlet selectedText = await get_string_variable(\"BTTTextSelection\");\n\t\n\tlet link = extractFirstLink(selectedText);\n\t\n\tif(!link) {\n selectedText = await get_string_variable(\"BTTTextSelectionRTF\");\n\t\n\tlink = extractFirstLink(selectedText);\n   }\n   if(link) {\n   let b64 = await fetchURLAsBase64(`https://is.gd/create.php?format=simple&url=${link}`);\n   let shortened = atob(b64);\n   \n    await set_clipboard_content({content:shortened, format: 'NSPasteboardTypeURL'})\n   set_string_variable({variableName: \"ShortenedURL\", to: shortened});\n   return shortened;\n\n   }\n   \n   // https://heise.de\n\n\n\t\treturn \"no link found\";\n}",
